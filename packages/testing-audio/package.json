{
  "name": "@sherpaw/testing-audio",
  "type": "module",
  "version": "0.0.4",
  "private": true,
  "description": "Sherpaw browser audio pipeline tests",
  "author": "Moeru AI",
  "license": "Apache-2.0",
  "exports": "./src/index.ts",
  "scripts": {
    "build:target": "pnpm --filter @sherpaw/xsai-transcription... build && vite build",
