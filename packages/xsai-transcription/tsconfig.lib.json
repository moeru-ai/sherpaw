{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext",
      "DOM",
      "WebWorker",
      "WebWorker.AsyncIterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "./wasm.d.ts"
    ],
    "allowImportingTsExtensions": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ]
}
