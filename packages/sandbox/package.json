{
  "name": "@sherpaw/sandbox",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b && tsc --noEmit -p tsconfig.speaker-tests.json && tsc --noEmit -p tsconfig.asr-tests.json",
    "test:speaker": "vitest run --config vitest.speaker.config.ts",
    "test:asr-realtime": "node ../../scripts/generate-realtime-asr.mjs && pnpm build && vitest run --config vitest.asr-realtime.config.ts"
  },
  "dependencies": {
    "@iconify-json/ri": "^1.2.6",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@sherpaw/asr": "workspace:^",
    "@sherpaw/preloader": "workspace:^",
    "@sherpaw/speaker-identification": "workspace:^",
    "@tsconfig/strictest": "^2.0.7",
    "@types/audioworklet": "^0.0.90",
    "@types/emscripten": "^1.41.5",
    "@types/node": "^24.6.0",
    "@unocss/reset": "^66.5.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "@vueuse/core": "^14.0.0",
    "onnxruntime-web": "1.27.0",
    "pretty-bytes": "^7.1.0",
    "reka-ui": "^2.6.0",
    "typescript": "~5.9.3",
    "unocss": "^66.5.4",
    "unplugin-vue-router": "^0.17.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "vue-tsc": "^3.1.0"
  },
  "devDependencies": {
    "@sherpaw/vitest-plugin-fakemic": "workspace:^",
    "@vitest/browser-playwright": "^4.1.9",
    "@webgpu/types": "0.1.74",
    "playwright": "^1.57.0",
    "unplugin-basemove": "0.0.1",
    "vitest": "^4.1.9"
  }
}
