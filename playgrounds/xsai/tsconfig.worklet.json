{
  "extends": [
    "@tsconfig/strictest/tsconfig"
  ],
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "ESNext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/audio-processor.worklet.ts"
  ]
}
